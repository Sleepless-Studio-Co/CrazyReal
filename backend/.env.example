# Configuration du serveur
DATABASE_URL="postgresql://user:password@localhost:5432/db?schema=public"
API_HOST=0.0.0.0
API_PORT=3000

# JWT Configuration
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Email verification (Resend — https://resend.com)
# Create an API key at https://resend.com/api-keys
# If RESEND_API_KEY is left empty the backend logs the verification link
# instead of sending a real email (handy for local development).
RESEND_API_KEY=
# Verified sender. Use the Resend sandbox sender for testing.
MAIL_FROM="CrazyReal <onboarding@resend.dev>"
# Public base URL of this API — used to build the verification link in emails.
APP_PUBLIC_URL=http://localhost:3000
