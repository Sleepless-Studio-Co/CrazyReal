# Configuration du serveur
DATABASE_URL="postgresql://user:password@localhost:5432/db?schema=public"
API_HOST=0.0.0.0
API_PORT=3000

# JWT Configuration
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Origines autorisées pour le WebSocket de chat (séparées par des virgules)
# Laisser vide pour autoriser toutes les origines (les clients mobiles natifs ne sont jamais concernés par CORS)
CHAT_CORS_ORIGIN=http://localhost:3000
