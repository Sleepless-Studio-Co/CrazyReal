# Configuration de l'API
API_BASE_URL=http://IP-PUBLIC-DE-LA-VM:3000

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials)
# ID client "Web" (server). Indispensable sur Android et utilisé comme audience
# du jeton vérifié côté API.
GOOGLE_SERVER_CLIENT_ID=708543476305-fv4ivptcv7u8veva3d47ckcfeq8j429e.apps.googleusercontent.com
# ID client iOS. Optionnel si défini dans ios/Runner/Info.plist (clé GIDClientID).
GOOGLE_CLIENT_ID=
